{
  "name": "dsh-advisory-impact",
  "version": "0.1.2",
  "description": "Local official-first Kafka, Hadoop and Flink advisory checks with pinned versions and a native DSH panel",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md",
    "docs/images/*.png"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "author": "hzopc1031",
  "keywords": [
    "dsh-plugin",
    "advisory-impact",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzopc1031/dsh-plugins.git",
    "directory": "packages/dsh-advisory-impact"
  },
  "homepage": "https://github.com/hzopc1031/dsh-plugins/tree/main/packages/dsh-advisory-impact#readme",
  "bugs": {
    "url": "https://github.com/hzopc1031/dsh-plugins/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=2 test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "dependencies": {
    "node-html-parser": "7.0.1",
    "saxes": "6.0.0",
    "undici": "6.29.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  }
}
