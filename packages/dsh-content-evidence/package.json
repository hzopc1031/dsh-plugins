{
  "name": "dsh-content-evidence",
  "version": "0.1.0",
  "description": "Evidence-based content workbench for DeepSeek Harness (in development)",
  "type": "module",
  "main": "index.js",
  "types": "lib/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin.d.ts",
      "default": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/model.d.ts",
      "default": "./lib/model.js"
    }
  },
  "files": [
    "index.js",
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "content-evidence"],
  "scripts": {
    "build": "tsc && node scripts/generate-remote.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.5 <0.3.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzopc1031/dsh-plugins.git",
    "directory": "packages/dsh-content-evidence"
  },
  "homepage": "https://github.com/hzopc1031/dsh-plugins/tree/main/packages/dsh-content-evidence#readme",
  "bugs": { "url": "https://github.com/hzopc1031/dsh-plugins/issues" },
  "author": "hzopc1031"
}
