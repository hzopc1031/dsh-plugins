{
  "name": "dsh-dll-doctor", "version": "0.1.2", "description": "只读 Windows DLL 依赖与架构诊断（DSH rc.5）",
  "type": "module", "main": "index.js", "types": "index.d.ts",
  "exports": { ".": { "types": "./index.d.ts", "default": "./index.js" }, "./core": { "types": "./lib/core.d.ts", "default": "./lib/core.js" }, "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg", "./package.json": "./package.json" },
  "files": ["index.js", "index.d.ts", "lib/*.js", "lib/*.d.ts", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "CHANGELOG.md", "STATUS.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "scripts/smoke-real.mjs", "scripts/fixture.mjs"],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0-0" }, "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "license": "MIT", "author": "hzopc1031", "keywords": ["dsh-plugin", "windows", "dll", "diagnostics"],
  "repository": { "type": "git", "url": "git+https://github.com/hzopc1031/dsh-plugins.git", "directory": "packages/dsh-dll-doctor" },
  "scripts": { "build": "tsc", "typecheck": "tsc --noEmit", "test": "npm run build && node --test test/*.test.mjs", "verify-pack": "node scripts/verify-pack.mjs" },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.5 <4.2.0", "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0", "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0", "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0", "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/schemastery": { "optional": true }, "@deepseek-ai/dsh-commands": { "optional": true }, "@deepseek-ai/dsh-subprocess": { "optional": true }, "@deepseek-ai/dsh-working-directory": { "optional": true } },
  "devDependencies": { "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/schemastery": "~3.18.5", "@deepseek-ai/dsh-commands": "0.2.1-rc.5", "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5", "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5", "@types/node": "^22.0.0", "typescript": "~5.9.3" }
}
