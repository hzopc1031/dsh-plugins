{
  "name": "dsh-file-holder",
  "version": "0.1.2",
  "description": "查询 Windows 项目内指定文件的占用程序（仅人类命令）",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "index.d.ts", "lib/*.js", "lib/*.d.ts", "file-holder.ps1", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "CHANGELOG.md", "STATUS.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0-0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "license": "MIT",
  "author": "hzopc1031",
  "keywords": ["dsh-plugin", "windows", "file", "restart-manager"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-working-directory": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "repository": { "type": "git", "url": "git+https://github.com/hzopc1031/dsh-plugins.git", "directory": "packages/dsh-file-holder" }
}
