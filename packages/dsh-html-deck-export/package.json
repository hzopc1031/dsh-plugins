{
  "name": "dsh-html-deck-export",
  "version": "0.1.0",
  "description": "Local HTML deck to image-based PPTX for DeepSeek Harness (scaffold)",
  "type": "module",
  "main": "index.js",
  "types": "lib/plugin.d.ts",
  "exports": {
    ".": { "types": "./lib/plugin.d.ts", "default": "./index.js" },
    "./adapters": { "types": "./lib/adapters.d.ts", "default": "./lib/adapters.js" },
    "./capture": { "types": "./lib/capture.d.ts", "default": "./lib/capture.js" },
    "./detect": { "types": "./lib/detect.d.ts", "default": "./lib/detect.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js", "lib/*.js", "lib/*.d.ts", "cordis.patch.yml",
    "locale/*.json", "icon.svg", "README.md", "LICENSE", "CHANGELOG.md"
  ],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "license": "MIT",
  "author": "hzopc1031",
  "keywords": ["dsh-plugin", "deepseek-harness", "html-deck", "pptx"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dependencies": { "puppeteer-core": "24.31.0" },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzopc1031/dsh-plugins.git",
    "directory": "packages/dsh-html-deck-export"
  },
  "homepage": "https://github.com/hzopc1031/dsh-plugins/tree/feat/html-deck-export/packages/dsh-html-deck-export#readme",
  "bugs": { "url": "https://github.com/hzopc1031/dsh-plugins/issues" }
}
