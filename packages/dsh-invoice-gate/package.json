{
  "name": "dsh-invoice-gate",
  "version": "0.1.0",
  "description": "Local invoice verification gate and evidence pack for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js", "index.d.ts", "lib/*.js", "lib/*.d.ts", "cordis.patch.yml",
    "locale/*.json", "icon.svg", "README.md", "LICENSE", "CHANGELOG.md", "docs/decisions.md", "docs/inputs.md", "docs/reconciliation.md", "docs/exports.md", "docs/tools.md"
  ],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "license": "MIT",
  "author": "hzopc1031",
  "keywords": ["dsh-plugin", "deepseek-harness", "invoice", "verification", "local"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzopc1031/dsh-plugins.git",
    "directory": "packages/dsh-invoice-gate"
  },
  "homepage": "https://github.com/hzopc1031/dsh-plugins/tree/feat/invoice-gate/packages/dsh-invoice-gate#readme",
  "bugs": { "url": "https://github.com/hzopc1031/dsh-plugins/issues" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.12.0",
    "pdfjs-dist": "4.10.38"
  },
  "overrides": {
    "exceljs": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
