{
  "name": "dsh-plugin-combo-lab",
  "version": "0.1.0",
  "description": "协助检查多个 DSH 插件一起安装时的命令名、界面位置、提示词或工具拦截冲突，结合人工记录定位问题，并在新装或升级后复查组合是否正常（当前每次检查两个插件）",
  "type": "module",
  "main": "index.js",
  "types": "lib/plugin.d.ts",
  "exports": {
    ".": { "types": "./lib/plugin.d.ts", "default": "./index.js" },
    "./core": { "types": "./lib/core.d.ts", "default": "./lib/core.js" },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "lib/*.js", "lib/*.d.ts", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "desktop", "regression"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "repository": { "type": "git", "url": "git+https://github.com/hzopc1031/dsh-plugins.git", "directory": "packages/dsh-plugin-combo-lab" },
  "author": "hzopc1031"
}