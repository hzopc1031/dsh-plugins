{
  "name": "dsh-snip-attach",
  "version": "0.2.3",
  "description": "Windows 框选截图后自动加入 DSH 待发送附件",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "capture.ps1"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "author": "hzopc1031",
  "keywords": [
    "dsh-plugin",
    "screenshot",
    "windows",
    "attachment"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "~5.9.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzopc1031/dsh-plugins.git",
    "directory": "packages/dsh-snip-attach"
  }
}
