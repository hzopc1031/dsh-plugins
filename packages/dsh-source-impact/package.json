{
  "name": "dsh-source-impact",
  "version": "0.2.0",
  "description": "Explicit source citation tracking and update impact checklists for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "default": "./lib/core.js"
    },
    "./store": {
      "types": "./lib/store.d.ts",
      "default": "./lib/store.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "source-impact",
    "citation",
    "markdown",
    "csv"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzopc1031/dsh-plugins.git",
    "directory": "packages/dsh-source-impact"
  },
  "homepage": "https://github.com/hzopc1031/dsh-plugins/tree/main/packages/dsh-source-impact#readme",
  "bugs": {
    "url": "https://github.com/hzopc1031/dsh-plugins/issues"
  },
  "author": "hzopc1031"
}
